#onetrust-banner-sdk {
  box-shadow: 0 -2px 2px 0 rgba(12,18,28,.12);
}

/* 2nd highest level container  ot-sdk-container */

#onetrust-banner-sdk .ot-sdk-container {
  display: none;
  width: 100% !important;
  padding: 0 !important;
  margin: 0 !important;
}

/* 3rd level container ot-sdk-row */

#onetrust-banner-sdk .ot-sdk-row {
  margin: 0 auto !important;
  min-height: 150px;
}

@media screen and (max-width: 896px) {
  #onetrust-banner-sdk .ot-sdk-row {
    padding: 0 16px !important;
  }  
}

@media screen and (min-width: 896px) {
  #onetrust-banner-sdk .ot-sdk-row {
    display: flex !important;
    align-items: center  !important;
    max-width: 1280px !important;
    padding: 0 24px !important;
  }
}


/* text container onetrust-group-container */

@media screen and (max-width: 896px) {
  #onetrust-banner-sdk #onetrust-group-container {
    width: 100% !important;
    padding: 0 !important;
  }
}

@media screen and (min-width: 425px) and (max-width: 896px) {
  #onetrust-banner-sdk #onetrust-group-container {
    padding: 24px 0 0 0 !important;
  }
}

/* container for mobile close button and paragraph onetrust-policy */

#onetrust-banner-sdk #onetrust-policy {
  margin: 0px !important;
}

#onetrust-close-btn-container-mobile {
}


/* paragraph */

#onetrust-banner-sdk #onetrust-policy-text {
  padding: 10px 0 !important;  
}

@media screen and (max-width: 896px) {
  #onetrust-banner-sdk #onetrust-policy-text {
    text-align: center !important;
    margin: 8px 0 0 0 !important;
  }
}

@media screen and (min-width: 896px) {
  #onetrust-banner-sdk #onetrust-policy-text {
    margin-bottom: 0 !important;
  }
}


/* container for buttons onetrust-button-group-parent */

@media screen and (min-width: 896px) {
  #onetrust-banner-sdk #onetrust-button-group-parent {
    margin-right: 0 !important;
  }
}

@media only screen and (min-width: 1024px) {
  #onetrust-banner-sdk:not(.ot-iab-2) #onetrust-button-group-parent {
    width: 50%;
  }
}

@media only screen and (min-width: 890px) {
  #onetrust-banner-sdk.ot-buttons-fw:not(.ot-iab-2) #onetrust-button-group-parent {
    padding-left: 0 !important;
  }
}

@media (min-width: 896px) and (max-width: 1024px) {
  #onetrust-banner-sdk .ot-sdk-three.ot-sdk-columns, #onetrust-pc-sdk .ot-sdk-three.ot-sdk-columns, #ot-sdk-cookie-policy .ot-sdk-three.ot-sdk-columns {
      width: 30% !important;
  }
}

/* 2nd container for buttons onetrust-button-group */
#onetrust-banner-sdk #onetrust-button-group {
  text-align: center !important;
  padding: 10px 0 !important;
}

@media screen and (min-width: 769px) {
  /* overriding built-in margin */
  #onetrust-banner-sdk #onetrust-button-group {
      margin-right: auto !important;
      margin-top: 0 !important;
  }
}

@media screen and (max-width: 896px) {
  #onetrust-banner-sdk #onetrust-button-group {
    padding-bottom: 24px !important;
    padding-top: 0px !important;
  }
}


/* buttons */

#onetrust-banner-sdk #onetrust-pc-btn-handler {
  color: #0070F0 !important;
  padding: 8px !important;
  margin: 8px 16px !important;
}

@media only screen and (max-width: 896px) {
/* overriding width */
  #onetrust-banner-sdk #onetrust-pc-btn-handler {
    width: calc(100% - 32px);
  }
}

#onetrust-banner-sdk #onetrust-accept-btn-handler {
  font-weight: 700 !important;
  border-radius: 24px !important;
  padding: 12px 24px !important;
  border: none !important;
  margin: 0 !important;
}

@media screen and (min-width: 896px) {
  #onetrust-banner-sdk #onetrust-accept-btn-handler {
    margin-right: 0 !important;
  }
}

/* desktop close button */

@media screen and (max-width: 896px) {
  #onetrust-banner-sdk #onetrust-close-btn-container {
    position: absolute !important;
    top: 12px !important;
    right: 16px !important;
    margin: 0 !important;
  }
}

@media screen and (min-width: 896px) {
  #onetrust-banner-sdk #onetrust-close-btn-container {
    position: absolute !important;
    top: 24px !important;
    right: 24px !important;
    width: auto !important;
    margin: 0 !important;
  }
}

@media screen and (min-width: 425px) and (max-width: 896px) {
  #onetrust-banner-sdk #onetrust-close-btn-container {
    top: 21px !important;
  }
}

/* Fixing issue with languages */

@media screen and (min-width: 1024px) {
  #onetrust-banner-sdk.vertical-align-content #onetrust-button-group-parent {
      position: inherit !important;
      top: inherit !important;
      left: inherit !important;
      transform: inherit !important;
  }
}

/* Vertically centering content */

@media screen and (min-width: 890px) {
  #onetrust-banner-sdk.ot-buttons-fw:not(.ot-iab-2) #onetrust-button-group button {
    width: auto !important;
  }
}

#onetrust-banner-sdk #onetrust-policy {
    margin: 0.625em 0 .625em 0 !important;
